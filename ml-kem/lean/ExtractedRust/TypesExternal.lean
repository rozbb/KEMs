-- Models of the external (non-extracted) types used by `ExtractedRust.Types`.
-- `TypesExternal_Template.lean` (regenerated by `../../extract_rust_to_lean.sh`) lists the expected
-- declarations. These models are part of our trusted base; see `TrustBase.lean`.
import Aeneas
import Wychelean.Hashes.SHA3.XOF.Basic
open Aeneas Aeneas.Std Result ControlFlow Error
open Wychelean.Hashes.SHA3 Incremental Internal

/-- [ctutils::choice::Choice]: a constant-time boolean. -/
@[rust_type "ctutils::choice::Choice"]
abbrev ctutils.choice.Choice : Type := Bool

/-- [sha3::Sha3_512]: a SHA3-512 hasher, modelled by the message it has absorbed so far. -/
@[rust_type "sha3::Sha3_512"]
abbrev sha3.Sha3_512 : Type := List Std.U8

/-- [sha3::Sha3_256]: a SHA3-256 hasher, modelled by the message it has absorbed so far. -/
@[rust_type "sha3::Sha3_256"]
abbrev sha3.Sha3_256 : Type := List Std.U8

/-- [shake::Shake_136]: a SHAKE256 hasher, modelled by the message it has absorbed so far. -/
@[rust_type "shake::Shake_136"]
abbrev shake.Shake_136 : Type := List Std.U8

/-- [shake::ShakeReader_136]: a SHAKE256 output reader, modelled by the absorbed message and the
number of bytes read so far. -/
@[rust_type "shake::ShakeReader_136"]
abbrev shake.ShakeReader_136 : Type := List Std.U8 × Nat

/-- [shake::Shake_168]: a SHAKE128 hasher, modelled by the absorbing sponge of the spec. -/
@[rust_type "shake::Shake_168"]
abbrev shake.Shake_168 : Type := sponge.absorbingState (b - 256)

/-- [shake::ShakeReader_168]: a SHAKE128 output reader, modelled by the squeezing sponge of the spec. -/
@[rust_type "shake::ShakeReader_168"]
abbrev shake.ShakeReader_168 : Type := sponge.state (b - 256)
