import TopLevelTheorems

/-!
# The trusted Lean base of our proofs

This module performs an accounting of all the axioms we use in our proofs. It panics if it
encounters an unexpected axiom used by one of the top-level theorems.

Besides these axioms, we trust the *models* of the crates we don't extract (`core`, `hybrid-array`,
`sha3`, `shake`, `ctutils`, `typenum`): the definitions in `ExtractedRust/TypesExternal.lean` and
`ExtractedRust/FunsExternal.lean` (generated by `scripts/gen_funs_external.py`). They are not
axioms, but nothing checks them against the actual crates either. Most are one-liners in terms of
Aeneas's own models of `core` (e.g. `hybrid_array::Array::concat` is list concatenation). The hash
functions are modelled by the SHA-3 and SHAKE functions of the spec, in the same way as the spec
defines `G`, `H`, `J`, `PRF` and `XOF` in terms of them; this is where we assume that the `sha3` and
`shake` crates are correct.

We also trust the extraction itself (Charon, Aeneas, and our LLBC fix-ups in
`scripts/fix_llbc.py`, which only restore declarations, rename items, or replace an operation by a
call to a function with the same semantics).
-/

open Lean

/-- Axioms that our top-level theorems may use -/
def audited : List String :=
  [-- Lean builtin. Propositional extensionality, `(a ↔ b) → a = b`
   "propext",
   -- Lean builtin. Axiom of choice
   "Classical.choice",
   -- Lean builtin. Elements related by R are definitionally equal in quotient space over rel R
   "Quot.sound"]

/- Go through everything declared in the top-level namespace and dump its axioms. Make sure every
axiom is on the list, and that the list has no unnecessary axioms. Otherwise throw an error -/

run_cmd do
  let ns := `MlKem.TopLevel
  let names := (← getEnv).constants.toList.map (·.1)
  -- Everything in the namespace, not just the theorems: a definition that pulls in a new axiom
  -- should fail the check even if no proof reaches it.
  let decls := names.filter ns.isPrefixOf
  if decls.isEmpty then
    throwError "NO AUDIT SURFACE — {ns} is empty. Has it been renamed, or did its import fail?"
  let mut found : Array String := #[]
  for d in decls do
    for a in (← Lean.collectAxioms d) do
      let s := a.toString
      if !found.contains s then found := found.push s
  let unexpected := found.filter (fun a => !audited.contains a)
  let unused := audited.filter (fun a => !found.contains a)
  unless unexpected.isEmpty && unused.isEmpty do
    throwError "TRUST BASE CHANGED — TrustBase.lean is out of date.\n\
      New assumptions not in the audited list: {unexpected.toList}\n\
      Audited assumptions no longer used: {unused}"
