import Lake
open Lake DSL

-- We use the aeneas library version given by AENEAS_VERSION.txt in the root of this crate
def aeneasRev : String := (include_str "../AENEAS_VERSION.txt").trimAscii.toString
require aeneas from git "https://github.com/AeneasVerif/aeneas.git"
  @ aeneasRev / "backends/lean"

package «mlkem»

-- Aeneas-extracted Rust code. Generated by `../extract_rust_to_lean.sh`.
lean_lib «ExtractedRust» where
  globs := #[.submodules `ExtractedRust]
  -- This is all auto-generated, so disable style linting warnings
  leanOptions := #[⟨`linter.style.nameCheck, false⟩]

-- Libraries with Rust impls as well as all auxiliary theorems/proofs about it
@[default_target]
lean_lib «MlKem» where
  globs := #[.andSubmodules `MlKem]

-- The ML-KEM spec, vendored from Wychelean. See `Wychelean/README.md`
lean_lib «Wychelean» where
  globs := #[.submodules `Wychelean]

-- Contains all the main theorems we prove about our Rust impl
@[default_target]
lean_lib «TopLevelTheorems»

-- Contains all the axioms we need in our proofs
@[default_target]
lean_lib «TrustBase»
